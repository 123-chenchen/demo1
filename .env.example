COMPOSE_PROJECT_NAME=pdf-chatbot

# Public ports exposed on the host.
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OLLAMA_PORT=11434

# Frontend build-time configuration.
# Leave empty in Docker so nginx proxies browser requests through /api.
FRONTEND_API_BASE_URL=
VITE_AUTH_DISABLED=false

# Backend startup. Docker Compose maps this to backend AUTO_INIT_DB.
BACKEND_AUTO_INIT_DB=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL. Use service name "postgres" inside Docker.
POSTGRES_HOST=postgres
POSTGRES_DB=pdf_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg://postgres:change-this-postgres-password@postgres:5432/pdf_chatbot

# Qdrant. Use service name "qdrant" inside Docker.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=document_chunks

# MinIO. Use service name "minio" inside Docker.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-this-minio-user
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET=pdf-documents
MINIO_SECURE=false

# Retrieval and generation.
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=5
RETRIEVAL_RELEVANCE_THRESHOLD=0.35
CHAT_PROVIDER=ollama
CHAT_TEMPERATURE=0.1
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_NAME=llama3
GOOGLE_MODEL_NAME=
GOOGLE_API_KEY=

# Auth. Generate a long random value before production deploy.
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Email/OTP delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
